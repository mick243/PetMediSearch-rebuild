{
  // 타입 검사용. 테스트와 기준선(contract)까지 전부 봅니다. 빌드는 tsconfig.build.json.
  //
  // TypeScript 6 은 기본값이 여럿 바뀌었습니다(strict 켜짐, types 비어 있음 등).
  // 기본값에 기대지 않고 필요한 것은 전부 적어 둡니다.
  "compilerOptions": {
    // Dockerfile · CI 의 Node 22 가 그대로 도는 문법까지만 씁니다.
    "target": "ES2023",
    "lib": ["ES2023"],
    // package.json 의 "type": "module" 과 함께 Node 의 ESM 규칙을 그대로 따릅니다.
    // 상대 경로 import 에는 확장자 .js 를 붙입니다(빌드 결과의 이름).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // 타입만 가져오는 import 는 import type 으로 씁니다. 빌드 결과에 남지 않아야 할 것이 섞이지 않습니다.
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,

    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
