# server/.env 의 본보기.
#
#   cp server/.env.example server/.env
#
# 실제 .env 는 git 에 올라가지 않습니다(.gitignore). 그래서 새로 받은 사람이
# 무엇을 채워야 하는지 알 방법이 없었고, 이 파일이 그 목록입니다.
# 값이 하나라도 비면 서버는 뜨지만 그 기능만 조용히 실패합니다.

# ── 필수 ────────────────────────────────────────────────

# API 포트. 8080 은 다른 프로젝트가 쓰고 있어 8081 을 씁니다.
PORT=8081

# DB 접속. docker compose 로 띄우면 DB_HOST 는 compose 가 db 로 덮어씁니다.
#
# 앱은 root 가 아니라 이 DB 의 행만 읽고 쓰는 전용 계정으로 붙습니다. root 로 두면 쿼리 하나가
# 잘못됐을 때 피해가 DB 서버 전체로 번집니다. 계정은 scripts/createDbUser.ts 가 만듭니다.
# 암호는 길고 무작위로 만듭니다 (16자 이상).
#   생성: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_HOST=localhost
DB_PORT=3306
DB_USER=petmedisearch_app
DB_PASSWORD=
DB_NAME=petmedisearch

# DB 의 root 암호. 계정 만들기(createDbUser.ts)·스키마 변경·백업(backup.sh)에만 씁니다.
# docker compose 는 DB 를 처음 만들 때 이 값을 root 암호로 쓰고, 앱 컨테이너에는 넘기지 않습니다.
# 저장소 어디에도 적지 마세요. 예전에는 scripts/importData.ts 에 root 암호가 박혀 있었습니다.
DB_ROOT_PASSWORD=

# 토큰 서명 키. 길고 무작위여야 합니다. 노출되면 누구나 로그인 토큰을 만들 수 있습니다.
#   생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# 화면이 올라가는 주소. 여기 없는 오리진에서 온 요청은 브라우저가 막습니다.
# 쉼표로 여러 개를 적을 수 있습니다.
CORS_ORIGIN=http://localhost:5000

# 소셜 로그인이 끝나고 돌아올 주소. 각 제공자 콘솔에 등록한 값과 정확히 같아야 합니다.
URL=http://localhost:5000

# ── 소셜 로그인 (쓰는 것만 채우면 됩니다) ───────────────

KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── 데이터 적재 (scripts/syncData.ts) ───────────────────

# 공공데이터포털 인증키
#   동물병원 https://www.data.go.kr/data/15154952/openapi.do
#   동물약국 https://www.data.go.kr/data/15155272/openapi.do
DATA_GO_KR_SERVICE_KEY=

# 좌표가 없는 시설의 주소를 좌표로 바꿀 때 씁니다. 카카오 REST API 키입니다.
KAKAO_REST_API_KEY=

# ── 선택 ────────────────────────────────────────────────

# 운영에서는 production 으로 둡니다. Swagger(/api)가 닫힙니다.
# NODE_ENV=production

# 프록시(nginx·Caddy·로드밸런서) 뒤에 둘 때만 켭니다. 앞에 놓인 프록시 수(보통 1)나,
# 프록시로 믿을 주소를 쉼표로 적습니다(loopback · uniquelocal 같은 이름, IP, 10.0.0.0/8 같은 대역).
# 켜지 않으면 요청 제한이 모든 사용자를 프록시 주소 하나로 묶습니다.
# 반대로 프록시가 없는데 켜면 요청 제한이 제 역할을 못 합니다. 켰다면 API 포트에는 그 프록시만
# 닿아야 합니다 — docker-compose.yml 은 그래서 API 를 127.0.0.1 에만 엽니다.
# 0 · false 는 끔, true 는 받지 않습니다(서버가 뜨지 않습니다). 읽는 규칙은 trustProxy.ts.
# TRUST_PROXY=1

# DB 커넥션 풀 크기(db/prisma.ts). MySQL 의 max_connections(기본 151)와 인스턴스 수를 함께 보세요.
# DB_POOL_SIZE=10

# 시설 조회 한 번에 내려줄 최대 건수.
# FACILITIES_LIMIT=50000

# 앱 계정을 만들 때 쓸 관리자 계정 이름 (scripts/createDbUser.ts). 관리형 DB 처럼 root 가
# 아닌 이름이면 적습니다. 비우면 root 입니다.
# DB_ROOT_USER=root

# 관리자 계정 만들기 (scripts/createAdmin.ts). 평소에는 비워 두고 실행할 때만 넘기세요.
# ADMIN_EMAIL=admin@petmedisearch.local
# ADMIN_PASSWORD=

# ── 접종·검진 푸시 알림 ──────────────────────────────────

# 웹 푸시 서명에 쓰는 키 한 쌍. 아래 명령으로 한 번 만들어 붙여 넣습니다.
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# 비워 두면 알림 기능만 꺼집니다 (GET /push/key 가 503, 나머지는 그대로 동작).
# 공개키는 화면에도 나가는 값이라 비밀이 아닙니다. 개인키는 절대 공개하지 마세요.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# 푸시 서비스가 문제를 알릴 곳. mailto: 여야 하고, 규격상 필수입니다.
# VAPID_SUBJECT=mailto:admin@example.com

# 알림 배치를 도는 시각(cron). 비워 두면 돌지 않습니다.
# 컨테이너의 시간대를 따르므로 compose 의 api 에 TZ=Asia/Seoul 이 있어야
# 한국 시간 기준이 됩니다. 아래는 매일 오전 9시.
# REMINDER_CRON=0 9 * * *

# ── 시설 후기 AI 요약 ────────────────────────────────────

# 후기가 5건 이상 쌓인 시설의 후기를 요약해 목록 위에 보여 줍니다.
# 어느 제공자를 쓸지 하나만 고릅니다: gemini | anthropic | openai
# 키가 비어 있으면 요약만 꺼집니다 (후기 목록은 summary: null 로 그대로 나갑니다).
# 제공자를 바꾸면 후기 본문이 나가는 사업자가 바뀌므로 개인정보처리방침 3장도 함께
# 고치세요 (client/src/pages/Privacy.tsx 의 "시설 후기 요약" 행, CLAUDE.md §4.11).
AI_PROVIDER=gemini

# Google Gemini — 지금 켜져 있는 것. 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 기본값은 flash 계열 최신을 가리키는 별칭입니다. 답이 흔들리지 않아야 하면
# 구체 모델(예: gemini-2.5-flash)로 못박으세요.
# GEMINI_MODEL=gemini-flash-latest

# Anthropic (Claude) — 꺼져 있음. 켜는 법은 server/ai/providers/anthropic.ts 머리에.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# OpenAI — 꺼져 있음. 켜는 법은 server/ai/providers/openai.ts 머리에.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# 개발용: 키 없이 화면과 저장 흐름만 볼 때. 운영(NODE_ENV=production)에서는 켜지지 않습니다.
# AI_PROVIDER=stub
